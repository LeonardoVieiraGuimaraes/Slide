% ============================================================================
% SISTEMA DE LAYOUTS COMPLETOS
% ============================================================================

% TITLE PAGE MODERNO: Layout horizontal com título em destaque
\newcommand{\titlepagemoderno}{
    \setbeamertemplate{title page}{
        \vfill
        \begin{columns}[onlytextwidth,T]
            \begin{column}{0.65\textwidth}
                \vskip1cm
                \begin{flushleft}
                    \textcolor{white}{\textbf{\Huge \inserttitle}}
                    \ifx\insertsubtitle\@empty%
                    \else%
                        \vskip0.5cm
                        \textcolor{newtanorange}{\textbf{\Large \insertsubtitle}}
                    \fi%
                \end{flushleft}
                \vskip1cm
                \textcolor{newtanorange}{\rule{10cm}{3pt}}
                \vskip1.5cm
                \begin{flushleft}
                    \textcolor{white}{\textbf{\Large \insertdisciplina}}
                \end{flushleft}
                \vskip0.8cm
                \begin{flushleft}
                    \textcolor{white}{\textbf{\large \insertinstituicao}}
                \end{flushleft}
                \vskip0.5cm
                \begin{flushleft}
                    \textcolor{newtanorange}{\textbf{\insertprofessor}}
                \end{flushleft}
                \vskip0.5cm
                \begin{flushleft}
                    \textcolor{white}{\insertdate}
                \end{flushleft}
            \end{column}
            \begin{column}{0.35\textwidth}
                \begin{center}
                    \vskip2cm
                    \newtonlogo[4cm]
                    \vskip1cm
                    \textcolor{newtonpurple}{\rule{6cm}{2pt}}
                    \vskip0.5cm
                    \textcolor{white}{\small \textbf{CENTRO UNIVERSITÁRIO}}
                    \\[0.2cm]
                    \textcolor{newtanorange}{\textbf{NEWTON PAIVA}}
                    \vskip1cm
                    \textcolor{newtonpurple}{\rule{4cm}{1pt}}
                \end{center}
            \end{column}
        \end{columns}
        \vfill
    }
}

% TITLE PAGE CLÁSSICO: Layout centralizado vertical
\newcommand{\titlepageclassico}{
    \setbeamertemplate{title page}{
        \vfill
        \begin{center}
            \newtonlogo[3cm]
            \vskip1cm
            \textcolor{white}{\textbf{\LARGE \insertinstituicao}}
            \vskip0.5cm
            \textcolor{newtanorange}{\rule{10cm}{2pt}}
            \vskip1cm
            \textcolor{white}{\textbf{\Large \insertdisciplina}}
            \vskip1.5cm
            \textcolor{white}{\textbf{\large \insertprofessor}}
            \vskip1cm
            \textcolor{white}{\insertdate}
        \end{center}
        \vfill
    }
}

