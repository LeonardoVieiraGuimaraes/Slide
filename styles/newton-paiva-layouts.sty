% ============================================================================
% SISTEMA DE RODAPÉS
% ============================================================================

% RODAPÉ PADRÃO: Numeração simples
\newcommand{\rodapepadrao}{
    \setbeamertemplate{footline}{
        \hfill
        \usebeamercolor[fg]{page number in head/foot}
        \usebeamerfont{page number in head/foot}
        \insertframenumber\,/\,\inserttotalframenumber\kern1em\vskip2pt
    }
}

% RODAPÉ COMPLETO: Com informações adicionais
\newcommand{\rodapecompleto}{
    \setbeamertemplate{footline}{
        \begin{beamercolorbox}[wd=\paperwidth,ht=0.8cm,dp=0.2cm]{footline}
            \begin{columns}
                \begin{column}{0.33\textwidth}
                    \hspace*{0.5cm}
                    \textcolor{white}{\tiny \insertdisciplina}
                \end{column}
                \begin{column}{0.34\textwidth}
                    \centering
                    \textcolor{newtanorange}{\tiny \insertprofessor}
                \end{column}
                \begin{column}{0.33\textwidth}
                    \hfill
                    \textcolor{white}{\tiny \insertframenumber\,/\,\inserttotalframenumber}
                    \hspace*{0.5cm}
                \end{column}
            \end{columns}
        \end{beamercolorbox}
    }
}

% RODAPÉ LIMPO: Sem rodapé
\newcommand{\rodapelimpo}{
    \setbeamertemplate{footline}{}
}

% ============================================================================
% SISTEMA DE TEMPLATES DE TITLE PAGE
% ============================================================================

% TITLE PAGE PADRÃO: Layout em duas colunas
\newcommand{\titlepagepadrao}{
    \setbeamertemplate{title page}{
        % REUTILIZA O COMANDO AUXILIAR DO CABEÇALHO PADRÃO
        \conteudocabecalhosimples
        
        \vskip1cm
        
        \begin{columns}[onlytextwidth,T]
            \begin{column}{0.60\textwidth}
                \vskip0.5cm
                \begin{flushleft}
                    \textcolor{white}{\textbf{\LARGE \insertdisciplina}}
                \end{flushleft}
                \vskip1.5cm
                \begin{flushleft}
                    \textcolor{white}{\textbf{\Large \insertinstituicao}}
                \end{flushleft}
                \vskip1cm
                \begin{flushleft}
                    \textcolor{white}{\textbf{\large \insertprofessor}}
                \end{flushleft}
                \vskip1cm
                \begin{flushleft}
                    \textcolor{white}{\insertdate}
                \end{flushleft}
            \end{column}

            \begin{column}{0.40\textwidth}
                \begin{center}
                    \vskip1cm
                    \ifx\@imagemcapa\@empty
                        \begin{beamercolorbox}[wd=0.8\textwidth,ht=4cm,center]{block body}
                            \vfill
                            \textcolor{black}{\small Inserir imagem aqui}\\
                            \textcolor{black}{\tiny Use: \textbackslash imagemcapa\{caminho\}}
                            \vfill
                        \end{beamercolorbox}
                    \else
                        \IfFileExists{\insertimagemcapa}{%
                            \includegraphics[width=0.8\textwidth,height=4cm,keepaspectratio]{\insertimagemcapa}
                        }{%
                            \begin{beamercolorbox}[wd=0.8\textwidth,ht=4cm,center]{block body alerted}
                                \vfill
                                \textcolor{black}{\small Imagem não encontrada}\\
                                \textcolor{black}{\tiny \insertimagemcapa}
                                \vfill
                            \end{beamercolorbox}
                        }%
                    \fi
                \end{center}
            \end{column}
        \end{columns}
        \vfill
    }
}

